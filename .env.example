DRAWARCH_TRANSPORT=http
HOST=0.0.0.0
PORT=3000
DRAWARCH_OUTPUT_DIR=.drawarch-output
DRAWARCH_ONLINE_ASSETS=false
DRAWARCH_API_KEY=replace-with-a-long-random-secret
DRAWARCH_APPROVAL_SECRET=replace-with-a-different-long-random-secret
